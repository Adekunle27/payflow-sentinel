# Anthropic API Key (for all Claude-powered agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ExchangeRate API (free tier: https://www.exchangerate-api.com/)
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key_here

# ERP Backend URL
ERP_BASE_URL=http://localhost:8000

# UiPath Cloud (fill after receiving Labs access)
UIPATH_CLOUD_URL=https://cloud.uipath.com
UIPATH_TENANT_NAME=your_tenant_name
UIPATH_CLIENT_ID=your_client_id
UIPATH_CLIENT_SECRET=your_client_secret
